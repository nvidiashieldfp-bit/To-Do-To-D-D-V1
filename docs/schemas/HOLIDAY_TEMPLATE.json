
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "To-Do To-Did Universal Holiday Definition (v1.0)",
  "description": "Canonical template for adding new countries. Must be strictly followed to ensure offline compatibility.",
  "type": "object",
  "required": ["country", "name", "defaultRegion", "regions", "holidays"],
  "properties": {
    "country": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 code (e.g., PT, US, JP)",
      "pattern": "^[A-Z]{2}$"
    },
    "name": {
      "type": "string",
      "description": "English name of the country"
    },
    "defaultRegion": {
      "type": "string",
      "description": "Fallback region code if detection fails"
    },
    "regions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "timezone"],
        "properties": {
          "name": { "type": "string" },
          "timezone": { "type": "string", "description": "IANA Timezone string" }
        }
      }
    },
    "holidays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "name", "type", "regions"],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO-8601 Date (YYYY-MM-DD)"
          },
          "name": {
            "type": "object",
            "required": ["en"],
            "additionalProperties": { "type": "string" },
            "description": "Multilingual name dictionary. 'en' is mandatory."
          },
          "type": {
            "type": "string",
            "enum": ["national", "regional", "optional"]
          },
          "regions": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of region codes or ['ALL'] for national holidays."
          }
        }
      }
    }
  }
}
